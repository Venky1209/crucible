{
  "name": "crucible",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Adversarial persuasion testing for customer-support AI agents: find the polite conversation that breaks your agent, with statistics you can trust.",
  "scripts": {
    "models": "node --env-file=.env src/models.js",
    "smoke": "node --env-file=.env src/smoke.js",
    "dev": "node --env-file=.env server.js",
    "mock": "node --env-file=.env mock-agent.js",
    "mock:voice": "node --env-file=.env mock-voice-agent.js",
    "cli": "node --env-file=.env cli.js",
    "calibrate": "node --env-file=.env calibrate.js",
    "study": "node --env-file=.env study.js",
    "test": "node --test test/",
    "dev:mock": "node server.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.3.0",
    "three": "^0.185.1"
  },
  "bin": {
    "crucible": "cli.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "license": "MIT"
}
