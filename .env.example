# Crucible's OWN key. Never reuse a key from another project.

# --- Option A (DEFAULT, recommended): Groq -> https://console.groq.com  free, no card
# Researched Aug 2026: ~30 RPM / 1K RPD free, org-level. 3x Gemini's headroom,
# which is what makes a live demo finish in ~35s instead of ~2.5min.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_RPM=28

# --- Option B: Google AI Studio -> https://aistudio.google.com/apikey  free, no card
# ~10 RPM / 250 RPD on Flash. Fine for the smoke test, tight for a live run.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# LLM_RPM=9

# Which attacks are active. More = better visuals, more calls, slower run.
# ADVERSARIES=social-engineer,policy-liar

PORT=3100

# --- Sarvam (optional): Indic attacks. https://dashboard.sarvam.ai  free signup credits
# SARVAM_API_KEY=sk_...
# CRUCIBLE_LANG=hindi   # hindi|tamil|bengali|telugu|marathi

# --- ElevenLabs (optional): renders an attack transcript as audio
# ELEVENLABS_API_KEY=

# Voice mode needs BOTH keys: ElevenLabs to speak, Sarvam to hear.
# VOICE_TIMEOUT_MS=45000
